{
  "name": "@truckmafia/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./kafka": "./src/kafka.ts",
    "./types": "./src/types.ts",
    "./jwt": "./src/jwt.ts"
  },
  "scripts": {
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "tsx src/migrate.ts --reset",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "pg-format": "^1.0.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "@types/pg-format": "^1.0.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
